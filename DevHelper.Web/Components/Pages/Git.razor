@page "/git"

<PageTitle>Git</PageTitle>

<h3>Git Init</h3>

<div style="max-width:600px">

    <label>Ruta</label>

    <input class="form-control"
           @bind="Ruta" />

    <br />

    <button class="btn btn-primary"
            @onclick="CrearRepo">
        Crear repositorio
    </button>

    <br />
    <br />

    <p>@Resultado</p>

</div>

@code {

    private string Ruta = "";

    private string Resultado = "";

    private Task CrearRepo()
    {
        Resultado = $"Ruta seleccionada: {Ruta}";
        return Task.CompletedTask;
    }

}